    {
      "name": "5. Create price alert - no token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/alerts/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alerts"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": 4500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Create price alert - valid token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/alerts/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alerts"
          ]
        },
        "description": "Threshold 7000 is the top of the DEL-BOM mock range, so Celery will always fire for this alert.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": 7000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Alert is active', () => pm.expect(j.status).to.eql('active'));",
              "pm.collectionVariables.set('alert_id', j.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. List own alerts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/alerts/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alerts"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Body is a list', () => pm.expect(j).to.be.an('array'));",
              "pm.test('Contains the alert just created', () => pm.expect(j.map(a => a.id)).to.include(Number(pm.collectionVariables.get('alert_id'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Deactivate an alert",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/alerts/{{alert_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "alerts",
            "{{alert_id}}"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Status is inactive', () => pm.expect(pm.response.json().status).to.eql('inactive'));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Mock price feed - valid route",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/flights/price/?route=DEL-BOM",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "flights",
            "price"
          ],
          "query": [
            {
              "key": "route",
              "value": "DEL-BOM"
            }
          ]
        },
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Route echoed', () => pm.expect(j.route).to.eql('DEL-BOM'));",
              "pm.test('Price in range 3000-7000', () => pm.expect(j.price).to.be.within(3000, 7000));"
            ]
          }
        }
      ]
    },
