{
  "info": {
    "name": "PulseNotify API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "13 scenarios for the PulseNotify assignment. Run requests in order."
  },
  "item": [
    {
      "name": "1. Register a new user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Body deliberately includes role=admin to prove the server ignores it.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Fresh username each run so the collection is re-runnable",
              "pm.collectionVariables.set('username', 'user_' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Returns JWT access token', () => pm.expect(j.access).to.be.a('string').and.not.empty);",
              "pm.test('Role defaults to user', () => pm.expect(j.role).to.eql('user'));",
              "pm.collectionVariables.set('user_token', j.access);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Register with duplicate username",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
