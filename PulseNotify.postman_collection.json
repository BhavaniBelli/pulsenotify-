    {
      "name": "12a. (Setup) Login as admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Requires an admin to exist: run `python manage.py create_pulse_admin` (or set role=admin in PGAdmin).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Role is admin', () => pm.expect(j.role).to.eql('admin'));",
              "pm.collectionVariables.set('admin_token', j.access);"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Admin summary - admin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/admin/summary/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "admin",
            "summary"
          ]
        },
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "['total_alerts','active_alerts','triggered_alerts','total_notifications'].forEach(k => pm.test(k + ' is a number', () => pm.expect(j[k]).to.be.a('number')));",
              "pm.test('top_routes is a list', () => pm.expect(j.top_routes).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Verify NotificationLog (PGAdmin check)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/admin/summary/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "admin",
            "summary"
          ]
        },
        "description": "PGAdmin check: run `SELECT * FROM pulse_notificationlog ORDER BY notified_at DESC;` - a row must exist after Celery fires. This request mirrors that check via total_notifications. Wait ~60s after request 6 (Beat interval) before running it. Note: request 8 deactivates the alert, so for a clean run create an alert (request 6), wait for Beat, THEN run 8.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Needs runserver + celery worker + celery beat running, and ~60s after request 6 for Beat to fire.",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('At least one NotificationLog row exists', () => pm.expect(pm.response.json().total_notifications).to.be.at.least(1));"
            ]
          }
        }
      ]
    }
